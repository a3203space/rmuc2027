  "driver": "import hashlib,json\nfrom pathlib import Path\nfrom rmuc2027_research.rl import learning\nfrom rmuc2027_research.rl.session import load_config\nfrom rmuc2027_research.rl.__main__ import benchmark\nout=Path('data/research/kinematic-contact-cachefix-full-840-20261109')\nconfig=load_config('configs/rl/sentry-mjwarp-hour.json');config['sim_backend']='warp_kinematic'\noriginal=learning.vector_env\n\ndef vector_env(*args,**kwargs):\n vec=original(*args,**kwargs);close=vec.close\n def audited_close():\n  try:\n   engines=list(vec.physics.engines.values())\n   flags=[batch.engine.motion.contact_exhausted.numpy().tolist() for batch in engines]\n   (out/'contact-diagnostics.json').write_text(json.dumps({'sticky_budget_flags_by_cached_batch':flags,'any_budget_exhaustion':any(any(a) for a in flags),'cached_batch_count':len(engines),'scope':'Sticky flags cover every 120Hz sample for each retained batch engine, including warmup. No new sampling is active while reading them. Evicted engines would not be represented; this fixed-lineup run uses at most two engine signatures.','driver_sha256':hashlib.sha256(Path(__file__).read_bytes()).hexdigest()},indent=2))\n  finally:close()\n vec.close=audited_close\n return vec\nlearning.vector_env=vector_env\nbenchmark(config,[2],840,out,action_pattern='uniform-random')\n",
